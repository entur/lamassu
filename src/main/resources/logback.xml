<configuration>
    <!-- logback 1.5.38 dropped Janino-based condition="..." expressions. The <condition> element
         must come before <if>, not inside it, or neither branch is applied. -->
    <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
        <expression>propertyContains("env", "dev")</expression>
    </condition>
    <if>
        <then>
            <include resource="org/springframework/boot/logging/logback/base.xml" />
        </then>
        <else>
            <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <pattern>
                            <pattern>
                                {
                                    "serviceContext": {
                                        "service": "lamassu"
                                    },
                                    "mdc": {
                                        "systemId": "%X{systemId}"
                                    },
                                    "message": "%message\n%ex{full}",
                                    "severity": "%level",
                                    "reportLocation": {
                                        "filePath": "%logger",
                                        "lineNumber": "%line",
                                        "functionName": "%method"
                                    }
                                }
                            </pattern>
                        </pattern>
                    </providers>
                </encoder>
            </appender>
            <logger name="com" level="WARN"/>
            <logger name="no" level="WARN"/>
            <logger name="org" level="WARN"/>
            <logger name="org.apache" level="ERROR"/>
            <logger name="org.entur.gbfs" level="ERROR"/>
            <root level="WARN">
                <appender-ref ref="console"/>
            </root>
        </else>
    </if>
</configuration>
